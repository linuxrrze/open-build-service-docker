# Copy to .env and fill in real values. .env is gitignored here since it
# holds a real MariaDB password, a real Rails secret_key_base, and real
# OIDC credentials.
#
# No OBS_ROOT / git-checkout path is needed anymore: the frontend/backend
# images bake the pinned open-build-service release in at build time (see the
# image READMEs). Only the data directories under ./fs/ are host-specific.

TZ=Europe/Berlin

# --- Images ---
# Registry path the frontend/backend images are pulled from (used by
# docker-compose.yml's image: lines): ghcr.io/<owner of the GitHub repo that
# builds them>, lowercase. Private packages need a `docker login ghcr.io`
# (a PAT with read:packages) on the host first.
OBS_IMAGE_PREFIX=ghcr.io/OWNER

# --- Backend schedulers ---
# Not configured here: the backend runs a scheduler for every architecture
# enabled in the web UI (Admin > Architectures, "Architecture Availability")
# and starts/stops them within ~30 seconds of a change.

# --- Instance configuration (configuration.xml, written at frontend start) ---
# Unset = keep what is stored in OBS's database (Admin > Configuration).
# OBS_NAME is the instance name in repository Origin ("obs://<name>/...") and
# the vendor of built RPMs -- pick it once and keep it. Default: private.
#OBS_NAME=private
#OBS_URL=https://obs.example.com
#OBS_ADMIN_EMAIL=admin@example.com

# --- Package / repository signing (backend) ---
# 1 = sign built packages and published repositories via signd (default),
# 0 = no signing. The key lives in the backend data dir (/srv/obs/gnupg,
# root-only -- back it up with the rest of fs/backend/srv/obs) and is
# generated on first start if it doesn't exist; the public key is exported to
# /srv/obs/obs-default-gpg.asc. To use your own key instead, import it
# (without passphrase) into that GnuPG home before starting and set
# OBS_SIGN_KEY_EMAIL to its email.
OBS_SIGN=1
OBS_SIGN_KEY_EMAIL=defaultkey@localobs
OBS_SIGN_KEY_NAME=private OBS
# Only used when the key is first generated:
OBS_SIGN_KEY_LENGTH=4096
OBS_SIGN_KEY_EXPIRE=0
# 1 = every new project gets its own signing key (created when its meta is
# saved); projects without one are signed with the default key above. To add
# a key to an existing project: osc signkey --create <project>
OBS_SIGN_FORCE_PROJECT_KEYS=1
# Signature digest. The sign tool defaults to SHA1, which current apt
# ("untrusted digest algorithm: SHA1") and rpm reject -- keep sha256 (or
# sha512). After changing it, republish existing repositories to re-sign
# them (see open-build-service-backend/README.md).
OBS_SIGN_HASH=sha256

# --- MariaDB ---
MARIADB_RANDOM_ROOT_PASSWORD=1
MARIADB_DATABASE=obs_api_production
MARIADB_USER=obs_api_production
MARIADB_PASSWORD=changeme

# --- Rails (frontend, RAILS_ENV=production) ---
# Signs/encrypts session cookies -- treat like a password. Generate your
# own, e.g.: docker run --rm ruby:3 ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
# NOTE: once a database is initialized with a given SECRET_KEY_BASE, changing
# it invalidates all existing sessions/encrypted values.
SECRET_KEY_BASE=changeme

# --- OIDC (frontend's Traefik middleware, docker-compose.yml.sample's
#     obs-oidc labels) -- s. https://github.com/lukaszraczylo/traefikoidc ---
OBS_OIDC_CLIENT_ID=changeme
OBS_OIDC_CLIENT_SECRET=changeme
OBS_OIDC_PROVIDER_URL=https://keycloak.example.com/realms/example
# Generate your own, same approach as SECRET_KEY_BASE above -- never reuse.
OBS_OIDC_SESSION_KEY=changeme

# --- OIDC account / login pages (frontend) ---
# These configure where OBS's UI links users for account management and
# (re-)login. The frontend's zz_container.rb initializer applies the values
# below over config/options.yml's (plain YAML, no ERB) at boot. Set them to
# point at your IdP's self-service account page (e.g. Keycloak's
# /realms/<realm>/account) and login page. Leave a variable unset (or empty)
# to keep the baked-in default (login/logout: /oauth2/callback, /oauth2/logout;
# account/register: none -- account editing is hidden and sign-up says
# "signing up is currently disabled").
#   OBS_PROXY_AUTH_LOGIN_PAGE    -> proxy_auth_login_page
#   OBS_PROXY_AUTH_LOGOUT_PAGE   -> proxy_auth_logout_page
#   OBS_PROXY_AUTH_ACCOUNT_PAGE  -> proxy_auth_account_page
#   OBS_PROXY_AUTH_REGISTER_PAGE -> proxy_auth_register_page
#OBS_PROXY_AUTH_ACCOUNT_PAGE=https://keycloak.example.com/realms/example/account
#OBS_PROXY_AUTH_REGISTER_PAGE=https://keycloak.example.com/realms/example/account

# --- API-token issuer (frontend-token) ---
# Shared secret between traefik (adds it as X-Obs-Issuer-Secret on the
# /_obs_api_token route) and the issuer (rejects requests without it), so
# only requests that went through traefik's OIDC login are accepted. At least
# 32 characters; generate like SECRET_KEY_BASE above.
OBS_API_TOKEN_ISSUER_SECRET=changeme-generate-at-least-32-characters

# --- API host (obs-api.example.com): per-user HTTP basic auth ---
# The frontend stays in OIDC proxy mode for the web UI, but this separate
# host lets scripts/cron jobs authenticate with a plain user:password.
# traefik's basicauth validates the credentials, then forwards
# X-username:<user> which OBS uses to attribute the API call.
#
# Users live in a shared htpasswd FILE (traefik's basicauth.usersFile reads
# ./fs/api-htpasswd/obs-api-htpasswd on the host), NOT in .env. This means
# nothing API-related belongs here: the self-service token issuer (the
# `frontend-token` compose service, reached at /_obs_api_token on the web
# host by a logged-in OIDC user) appends/removes users in that file at
# runtime, and traefik picks up changes on its file watch -- no traefik
# restart per user, and no $-in-.env interpolation problem.
#
# ONCE on the host (before first `docker compose up`): pre-create the dir +
# an empty file, owned by the frontend user's uid (1000) so the issuer can
# write it:
#   mkdir -p fs/api-htpasswd && chown 1000:1000 fs/api-htpasswd \
#     && : > fs/api-htpasswd/obs-api-htpasswd
# (compose would create a missing bind dir root-owned, which the frontend
# user can't write; the empty file also gives traefik something to read at
# t=0.) There's deliberately no variable here to fill in -- user management
# is entirely self-service (see open-build-service/README.md, "API access
# without OIDC").
